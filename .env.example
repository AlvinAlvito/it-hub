DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ithub

# Rahasia sesi login (acak, minimal 32 karakter)
AUTH_SECRET=
# Kunci enkripsi password akun, 32 byte dalam base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Token GitHub baca saja (fine-grained: Contents read, Metadata read) untuk repo privat
GITHUB_TOKEN=
GITHUB_USER=AlvinAlvito
# Email commit lain milik Anda, pisahkan koma
GITHUB_EMAILS=

# Rahasia untuk cron sinkron otomatis
CRON_SECRET=

UPLOAD_DIR=./uploads
